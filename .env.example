# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Security & Authentication Secrets (CHANGE IN PRODUCTION)
JWT_SECRET="replace-with-a-64-char-cryptographically-random-secret"
JWT_REFRESH_SECRET="replace-with-another-64-char-random-refresh-secret"
COOKIE_SECRET="replace-with-cookie-signing-secret"

# Initial Development Admin Bootstrap (Override in production)
ADMIN_INIT_USERNAME="admin"
# Leave ADMIN_INIT_PASSWORD unset in code; set securely in your environment before first boot
# ADMIN_INIT_PASSWORD=""

# Environment Mode
NODE_ENV="development"
PORT="3000"
DB_PATH="./data/casastyle.db"
